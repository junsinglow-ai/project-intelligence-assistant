# Managed services behind the hosted demo (DECISIONS.md D-008).
#
# Copy to `.env.cloud` and fill in; `.env.cloud` is gitignored and holds real
# credentials. This file is loaded ON TOP of `.env` by the `*-cloud` targets
# and by `make deploy-backend`, so `.env` stays pointed at the local Qdrant and
# Redis containers and `make up` / `make ingest` are unaffected.
#
# Sourced by the shell rather than parsed by Compose, so quote every value: a
# Redis password routinely contains characters the shell would otherwise treat
# as syntax.

# --- Qdrant Cloud ---------------------------------------------------------
# The cluster endpoint, with the port. The dashboard shows it under "Connect".
QDRANT_URL="https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east-1-0.aws.cloud.qdrant.io:6333"
QDRANT_API_KEY=""

# --- Redis Cloud ----------------------------------------------------------
# Must be a Redis with the RediSearch module: the checkpointer creates search
# indices at startup. Redis Cloud's free tier has it; Upstash does not, and the
# failure is quiet -- the graph degrades to the in-process saver and still
# answers. `make deploy-check` is what catches it.
REDIS_URL="rediss://default:PASSWORD@HOST:PORT"

# --- Deployed frontend ----------------------------------------------------
# The Vercel origin, for CORS. Comma-separated; no trailing slash. Unknown
# until the frontend is first deployed, so this is set on the second pass.
CORS_ORIGINS="http://localhost:5173"

# --- Google Cloud ---------------------------------------------------------
# GCP_REGION must be one of the three the Cloud Run free tier covers:
# us-central1, us-east1 or us-west1.
GCP_PROJECT=""
GCP_REGION="us-central1"
