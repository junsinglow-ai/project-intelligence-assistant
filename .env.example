# Copy to .env and fill in. Never commit .env.
#
# NOTE: comments must be on their own line. Docker Compose's env_file parser
# does not strip trailing comments, so `KEY=value  # note` sets KEY to
# "value  # note".

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# ==========================================================================
# DEPLOYMENT MODE  --  the cloud <-> on-premises switch
# ==========================================================================
# cloud  : generation runs against a hosted LLM API (needs LLM_API_KEY).
# onprem : generation runs against Ollama on the internal network. No
#          component makes an external call, and no API key is needed.
#
# This is the only variable you need to change. Everything else -- embeddings,
# keyword search, re-ranking, the vector store, the tabular engine, the graph
# checkpointer -- stays inside the deployment (in-process, or the Qdrant and
# Redis containers on the Compose network) and is identical in both modes, so
# the switch needs no re-index and
# an index built in one mode is valid in the other. See ARCHITECTURE.md §8.
DEPLOYMENT_MODE=cloud

# --- LLM ------------------------------------------------------------------
LLM_PROVIDER=google
LLM_MODEL=gemma-4-26b-a4b-it
ROUTER_MODEL=gemma-4-26b-a4b-it
# Per-agent models: AGENT_MODELS__<AGENT_NAME>, each a chain, preferred first.
# The paid tier bills by token, so each agent runs on the cheapest model that
# does its job. An agent without an entry uses LLM_MODEL; `router` and
# `rewrite` (follow-up rewriting) fall back to ROUTER_MODEL. In cloud mode the
# defaults below already apply (app/config.py); on-prem has none, so every call
# runs on the one resident model. Set a key only to override one agent -- the
# others keep their defaults -- and remember an explicit key applies in both
# modes. A key naming no registered agent is reported by `make ready`.
AGENT_MODELS__ROUTER=gemma-4-26b-a4b-it,gemini-3.5-flash-lite,gemini-3.5-flash
AGENT_MODELS__REWRITE=gemma-4-26b-a4b-it,gemini-3.5-flash-lite,gemini-3.5-flash
AGENT_MODELS__SMALL_TALK=gemma-4-26b-a4b-it,gemini-3.5-flash-lite,gemini-3.5-flash
AGENT_MODELS__DOCUMENT_QA=gemma-4-26b-a4b-it,gemini-3.6-flash,gemini-3.8-flash
AGENT_MODELS__DATA_ANALYSIS=gemma-4-26b-a4b-it,gemini-3.6-flash,gemini-3.8-flash
# Blank: 60s in cloud mode, 600s on-prem.
LLM_TIMEOUT_S=60
LLM_NUM_CTX=8192
# Retries on a failed generation. In cloud mode a failure is usually the free
# tier's quota. This only helps against a per-minute limit -- once a daily quota
# is spent every retry fails too, and each attempt still waits LLM_TIMEOUT_S.
# Ignored on-prem: ChatOllama has no retry parameter and has no quota to trip.
LLM_MAX_RETRIES=2

# cloud mode only; ignored on-prem, so it can stay set when switching.
LLM_API_KEY=

# onprem mode only; ignored in cloud mode, so it can stay set. The Ollama host:
# the bundled container (`make up-onprem`), the host machine, or a more powerful
# box on the internal network, e.g. http://gpu-box.internal:11434. A remote host
# on the internal network is still on-premises -- nothing leaves the deployment
# boundary. `ollama` is the Compose service name; host-side tooling (`make
# models`) reaches the same container on localhost:11434.
OLLAMA_BASE_URL=http://ollama:11434

# --- Embeddings -----------------------------------------------------------
# Identical in both modes; runs in-process and never calls out.
# Changing EMBEDDING_MODEL is the one change that is NOT config-only: vector
# dimensions differ between models, so it requires `make reindex`. The model is
# stamped into the Qdrant collection name so a mismatch fails loudly.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Where the ONNX weights are cached. Blank uses each library's own default,
# which is what local development wants. The Docker image sets both so the
# weights are baked in at build time: on a scale-to-zero host (Cloud Run,
# Render) an unset cache re-downloads ~150MB on every cold start, inside the
# first user's request. See DECISIONS.md D-008.
EMBEDDING_CACHE_DIR=

# --- Ingestion and chunking (identical in both modes) ---------------------
# Chunking follows document structure: PDF sections and table row groups.
# CHUNK_SIZE also caps how many table rows share a chunk, so wide and narrow
# tables both chunk sensibly.
DATA_RAW_DIR=./data/raw
UPLOAD_DIR=./data/uploads
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
TABLE_ROWS_PER_CHUNK=4

# --- Vector store (identical in both modes) -------------------------------
# The stack runs Qdrant as its own container (docker-compose.yml), and this URL
# is how host-side tooling -- `make ingest`, `make reindex`, `make query` --
# reaches the same index the API serves from. Inside the Compose network the
# backend overrides the host to http://qdrant:6333.
#
# Blank QDRANT_URL falls back to embedded mode: Qdrant runs in-process from
# QDRANT_PATH with no server, at the cost of a directory lock that lets only one
# process hold the index at a time. See DECISIONS.md D-003.
#
# QDRANT_API_KEY is empty for local development, which leaves the bundled server
# unauthenticated on the Compose network. Setting it locks that server and
# authenticates the backend with the same value.
VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_PATH=./data/qdrant
QDRANT_API_KEY=
QDRANT_COLLECTION=project_docs

# --- Retrieval (identical in both modes) ----------------------------------
# RETRIEVAL_MODE: naive | hybrid. naive is vector-only and is kept as the
# RAGAS baseline that hybrid is measured against.
# RRF_K is the reciprocal rank fusion constant.
RETRIEVAL_MODE=hybrid
RERANK_ENABLED=true
RERANK_MODEL=ms-marco-MiniLM-L-12-v2
# As EMBEDDING_CACHE_DIR. FlashRank's own default is /tmp, which in a
# container is memory rather than disk.
RERANK_CACHE_DIR=
RERANK_TOP_N=4
RRF_K=60
TOP_K=8

# --- Agent skill loops (identical in both modes) --------------------------
# How many tools an agent may call while answering one question. Each call
# costs another generation, and on-prem a generation is measured in minutes
# (ARCHITECTURE.md §2.1), so lower this on a constrained host -- 1 makes every
# agent a single search or query, as the pre-LangGraph pipeline was.
#
# Lowered from the code default of 3 because a budget of N costs up to N+1
# answering generations, on top of one rewrite and one routing call. At 2 a
# question costs at most 3 calls on LLM_MODEL and 2 on ROUTER_MODEL.
AGENT_MAX_TOOL_CALLS=2

# --- Graph checkpointing (identical in both modes) ------------------------
# Where the chat graph checkpoints its state. The stack runs Redis as its own
# container (docker-compose.yml), and this URL is how host-side tooling and
# `make dev-backend` reach the same store the API uses; inside the Compose
# network the backend overrides the host to redis://redis:6379/0.
#
# Blank REDIS_URL keeps the checkpointer in-process: nothing to run, but
# checkpoints are lost on restart and are not shared between replicas. An
# unreachable Redis degrades to the same in-process saver with a WARNING rather
# than failing the request, so a checkpoint outage is visible at
# /v1/health/dependencies, not in the answers. See DECISIONS.md D-007.
#
# CHECKPOINT_TTL_MINUTES expires an abandoned thread. It is refreshed whenever
# the thread is read, so a long conversation is never expired underneath itself.
REDIS_URL=redis://localhost:6379/0
CHECKPOINT_TTL_MINUTES=120
# Socket timeout for checkpoint reads/writes, in seconds. Raise it when the
# Redis is not in the same region as the application -- every checkpoint
# operation is then a round trip across that distance, and the graph makes
# several per request.
REDIS_TIMEOUT_S=30

# --- Tabular analysis (identical in both modes) ---------------------------
TABULAR_DB_PATH=./data/processed/tables.duckdb

# --- API keys (identical in both modes) ----------------------------------
# Off by default. When true, every /v1 endpoint except /v1/health/dependencies
# needs an X-API-Key header. Issue one with `make api-key NAME=frontend`; only
# its SHA-256 digest is stored, in its own DuckDB file (never tables.duckdb,
# which the model's SQL can read). `make api-keys` lists, `make revoke-api-key
# NAME=...` revokes; a running backend picks either up within 30 seconds.
API_AUTH_ENABLED=false
API_KEYS_DB_PATH=./data/processed/api_keys.duckdb

# --- Uploads ---
MAX_UPLOAD_MB=20

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
# Sent as X-API-Key when API_AUTH_ENABLED=true. Baked into the JavaScript
# bundle, so anyone who loads the page can read it: it identifies and lets you
# revoke the frontend, it does not keep the API private (ARCHITECTURE.md §6.2).
VITE_API_KEY=
