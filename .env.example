# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- LLM / embeddings (provider-agnostic; see backend/app/llm/providers.py) ---
LLM_PROVIDER=openai          # e.g. openai | anthropic | ollama
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_PROVIDER=openai    # e.g. openai | ollama | huggingface
EMBEDDING_MODEL=

# --- Retrieval ---
VECTOR_STORE=                # decide Day 1, log in DECISIONS.md
RETRIEVAL_MODE=hybrid        # naive | hybrid  (naive kept for RAGAS baseline)
RERANK_ENABLED=true
TOP_K=8

# --- Uploads ---
MAX_UPLOAD_MB=20

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
